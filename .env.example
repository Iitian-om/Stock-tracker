# Copy to .env  (never commit .env)
PRICE_SOURCE=mock          # mock = fake prices, works offline | yahoo = real prices
SYMBOLS=RELIANCE.NS,TCS.NS,INFY.NS,AAPL
FETCH_INTERVAL=60
# Leave DATABASE_URL unset to use SQLite. On AWS, point it to RDS:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@YOUR-RDS-ENDPOINT:5432/stocks
